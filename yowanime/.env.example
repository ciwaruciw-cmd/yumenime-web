# ============================================================
# Yumenime / Yowanime — Environment Configuration Template
# Copy this file to `.env` and fill in your values.
# ============================================================

# ── Backend Server & Database ──────────────────────────────
PORT=3001
DATABASE_URL="postgresql://yowa:yowapassword@localhost:5432/yowanime?schema=public"

# ── Auto-Scraper Configuration ──────────────────────────────
# Aktifkan background auto-scraper (true / false)
AUTO_SCRAPE=true

# Interval scrape otomatis dalam satuan jam (contoh: 6 = setiap 6 jam)
SCRAPE_INTERVAL_HOURS=6

# Jalankan scrape langsung saat server start (true / false)
SCRAPE_ON_START=false

# ── Frontend Configuration ──────────────────────────────────
# Set empty string for local same-origin proxy, or full backend URL in production
VITE_API_BASE_URL=

# Enable PostgreSQL mode in frontend (fallback uses local JSON database)
VITE_USE_POSTGRES=false

# ── Public APIs (100% Free, No API Key Required) ────────────
# AniList GraphQL API (Trending, Popular, Top Rated metadata)
VITE_ANILIST_API_URL=https://graphql.anilist.co

# Jikan API (Public MyAnimeList REST API fallback)
VITE_JIKAN_API_URL=https://api.jikan.moe/v4
